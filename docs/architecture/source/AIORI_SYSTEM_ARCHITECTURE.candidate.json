    { "dot": "cyan", "title": "One web application, two APIs", "items": ["Study pages call the Study API: 2023 GRU forecasts, metrics and federated evidence", "Replay and Explorer pages call the Replay & Disruption API, which also serves every Study API route", "useRemote caches responses and cancels stale requests"] },
    { "dot": "emerald", "title": "Selected federated model", "items": ["MLP + FedAvgM, history A, chosen on validation data only", "Test WAPE Jul–Dec 2024: 10.506% IID, 10.546% geographic (naive persistence 12.495%)", "Replay refuses to start unless every frozen checkpoint hash matches"] },
    { "dot": "amber", "title": "Offline, not at request time", "items": ["Preprocessing, federated training, model selection and the anomaly catalog are batch jobs", "Federated learning is a single-process simulation with four clients", "The APIs only read frozen files; disruptions are statistical candidates, not confirmed incidents"] }
