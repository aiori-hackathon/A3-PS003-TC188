  "cards": [
    { "dot": "cyan", "title": "Frontend", "items": [
      "React 19 + TypeScript + Vite + Tailwind + Recharts SPA",
      "Loads /health, /metrics, /sensors, /demo, /models on start; POST /predict from the Forecasting page",
      "Built to app/web/dist; the Python server also serves that build at / (SPA routes fall back to index.html)"
    ] },
    { "dot": "emerald", "title": "API (app/backend/server.py)", "items": [
      "GET /health /models /sensors /metrics /demo, POST /predict (also under /api/)",
      "Historical replay, or a 12-reading future forecast; JSON body under 20 kB",
      "CORS only for AIORI_CORS_ORIGINS; anonymised sensor ids, no station ids or paths returned"
    ] },
    { "dot": "violet", "title": "AI / ML models", "items": [
      "Served: local-only GRU (seed 1, one model per client) and centralised GRU",
      "Optimized MLP serves historical replay only when AIORI_CANDIDATE=1 (needs a week of history)",
      "Training compares centralised, local-only, IID FedAvg and geographic FedAvg"
    ] },
    { "dot": "amber", "title": "Storage", "items": [
      "No database server: all state is files (.npy, .npz, .json, .pt) loaded once at start-up",
      "Artifacts are git-ignored; a deployment downloads them from a private Hugging Face dataset (deploy/hf-space/start.sh)"
    ] },
    { "dot": "slate", "title": "Hosting", "items": [
      "Local: server on 127.0.0.1:8000, Vite dev proxy on :5173",
      "Vercel rewrites /api/* to a Hugging Face Space URL; that Space was never created, so this route has no backend yet"
    ] }
  ]
