    { "id": "read", "from": "replay", "to": "arrays", "y": 515, "label": "flow, valid, typical" },
    { "id": "readret", "from": "arrays", "to": "replay", "y": 550, "label": "200 readings", "variant": "return" },
    { "id": "frameret", "from": "replay", "to": "rs", "y": 590, "label": "values, status, relative", "variant": "return", "note": "missing/invalid → null, never 0" },
    { "id": "json", "from": "rs", "to": "remote", "y": 645, "label": "200 JSON", "variant": "return" },
    { "id": "ready", "from": "remote", "to": "view", "y": 680, "label": "frame ready → next step", "variant": "return" },
    { "id": "pick", "from": "user", "to": "view", "y": 730, "label": "click sensor, Forecast" },
    { "id": "fc", "from": "view", "to": "rs", "y": 765, "label": "GET /forecast?sensor&time&partition", "variant": "emphasis", "note": "partition geo or iid" },
    { "id": "fcfn", "from": "rs", "to": "replay", "y": 820, "label": "forecast(): t0 = T + 5 min", "note": "inputs T−55..T; all imputed → 422" },
    { "id": "fcret", "from": "replay", "to": "view", "y": 880, "label": "forecast, actual, MAE, WAPE", "variant": "return" }
