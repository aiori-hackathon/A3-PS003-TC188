 "cards": [
  {
   "dot": "emerald",
   "title": "Detection rule",
   "items": [
    "Scored only for valid readings with a typical flow ≥ 5 vehicles per 5 min",
    "Anomalous: z ≤ −4.93 or z ≥ +5.33 AND at least 25% from typical",
    "Thresholds = median over sensors of each sensor's 0.1% / 99.9% z quantile on clean 2023 readings"
   ]
  },
  {
   "dot": "violet",
   "title": "Grouping and ids",
   "items": [
    "Clean segments of one direction in one dataset region overlapping within 15 min → one event",
    "Quality-dominated segments: per-sensor episodes joined within 24 h, never across sensors",
    "Event id = start time, region, direction, hash of config + sensors + interval (deterministic)"
   ]
  },
  {
   "dot": "amber",
   "title": "Quality flags",
   "items": [
    "zero_reading, stuck_run (≥ 1 h same value), near_missing (≤ 1 h from a gap), level_shift (> 5% of a month anomalous)",
    "≥ 50% flagged readings → sensor_quality category",
    "Categories describe shape only; causes are never inferred"
   ]
  },
  {
   "dot": "slate",
   "title": "Reproducibility",
   "items": [
    "baseline.npz stores the build_baseline() median, spread, support and day types used by the API",
    "Build ~14 s on CPU; catalog, baseline and sha256 written atomically",
    "Rebuild gives an identical event list (events_sha256) and baseline file",
    "Retrospective: whole days are used; not a live detector"
   ]
  }
 ]
