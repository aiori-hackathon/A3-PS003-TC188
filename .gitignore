# --- Raw XTraffic dataset (CC BY-NC 4.0; never commit) ---
src/year_2022/
src/year_2023/
src/year_2024/
year_2023/
*.npy
node_order.npy
sensor_meta_feature.csv
incidents_y*.csv

# --- Generated / derived data (regenerate with aiori.flow_audit and aiori.prepare_pilot) ---
# Includes derived arrays, sensor metadata and assignments, selection manifests,
# generated reports with local paths, verification results and the v1 archive.
*.npz
src/data/processed/
# The local raw-file hash baseline is the only data file intended for the repository.
src/data/*
!src/data/raw_integrity_baseline.json

# --- Model artifacts and experiment outputs ---
# Checkpoints never enter Git. Results stay local, except the small Stage 3 analysis folder and the
# Stage 1-2 result tables, which document the final model selection.
*.pt
*.pth
*.ckpt
src/results/*
!src/results/aiori2/
src/results/aiori2/*
!src/results/aiori2/phase8c_stage3/
src/results/aiori2/phase8c_stage3/*
!src/results/aiori2/phase8c_stage3/analysis/
!src/results/aiori2/phase7_stage1/
src/results/aiori2/phase7_stage1/*/

# --- Python environment and caches ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Local-only research files (sensor-level identifiers, local paths, internal detail) ---
src/docs/preprocessing_review.md
src/docs/pre_phase6_research_validity.md
src/docs/project_readiness_audit.md
src/scripts/analysis/

# --- Logs and temporary files ---
*.log
*.tmp

# --- graphify knowledge-graph output (local paths in helper files) ---
graphify-out/

# --- Front end (app/web): dependencies and build output are regenerated by npm ---
node_modules/
src/app/web/dist/

# --- Isolated GPU environment for accuracy optimisation ---
.venv-gpu/

# --- Local tool state and Archify receipts (receipts carry absolute local paths) ---
.impeccable/
.archify/
docs/**/*.finalize.json
docs/**/*.finalize-summary.json
docs/**/*.delivery.json
docs/**/*.browser-check.json
*.tsbuildinfo

# --- Local rollback copies, retired tunnel tooling and deployment run-time state (kept on disk) ---
src/app/backups/
.keepalive/
deploy/aiori/logs/

# --- Machine-specific Stage 3 training watchdog (kept on disk) ---
src/aiori2_watchdog/
src/tests/test_aiori2_watchdog.py

# --- Internal planning reports and session notes (kept on disk) ---
