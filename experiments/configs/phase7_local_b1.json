{
  "arm": "local_b1",
  "description": "Local-only: each geographic client trains alone; B1 GRU (docs/phase7_technical_spec.md)",
  "partition": "geographic",
  "max_epochs": 50,
  "early_stopping_scope": "per_client_own_validation",
  "calendar": true,
  "hidden_size": 64,
  "optimizer": "adam",
  "lr": 0.001,
  "batch_size": 512,
  "patience": 5,
  "grad_clip": 1.0,
  "lr_schedule": null,
  "early_stopping_metric": "validation pooled MAE, raw units",
  "clip_negative_predictions": false,
  "seeds": [0, 1, 2],
  "threads": 8
}
